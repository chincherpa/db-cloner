{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DB Cloner",
  "version": "0.1.0",
  "identifier": "com.chincherpa.db-cloner",
  "build": {
    "beforeDevCommand": "npm run ensure-icons && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run ensure-icons && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DB Cloner",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "pg-tools": "pg-tools"
    }
  }
}
